; VARIOUS PREPROCESSING OPTIONS
; Preprocessor information: use cpp syntax.
; e.g.: -I/home/joe/doe -I/home/mary/roe
include                  = 
; e.g.: -DPOSRES -DFLEXIBLE (note these variable names are case sensitive)
define                   = -DPOPC_PO4 -DPOPS_PO4 -DPHE_BB

; RUN CONTROL PARAMETERS
integrator               = steep
; Start time and timestep in ps
tinit                    = 0
dt                       = 0.010
nsteps                   = 10000 ; 100 000 * 0.010 ps ; 100*10ps ; 1000ps ; 1ns
init_step                = 0
simulation_part          = 1
comm-mode                = Linear
nstcomm                  = 10
comm-grps                = 

; LANGEVIN DYNAMICS OPTIONS
; Friction coefficient (amu/ps) and random seed
bd-fric                  = 0
ld-seed                  = 1993

; ENERGY MINIMIZATION OPTIONS
; Force tolerance and initial step-size
emtol                    = 100.0 ;
emstep                   = 0.010
niter                    = 20
fcstep                   = 0
nstcgsteep               = 1000
nbfgscorr                = 10

; TEST PARTICLE INSERTION OPTIONS
rtpi                     = 0.05

; OUTPUT CONTROL OPTIONS
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 100
nstcalcenergy            = 100
nstenergy                = 100
nstxtcout                = 1 ; 1 000 * 0.010 ps ; 1 * 10ps ; 10ps
xtc-precision            = 100

; NEIGHBORSEARCHING PARAMETERS
nstlist                  = 10
ns_type                  = grid
pbc                      = xyz
periodic_molecules       = no
rlist                    = 1.6
rlistlong                = -1

; OPTIONS FOR ELECTROSTATICS AND VDW
; Method for doing electrostatics
coulombtype              = PME
rcoulomb_switch          = 0.0
rcoulomb                 = 1.6
epsilon_r                = 2.5
epsilon_rf               = 1
vdw_type                 = Shift
rvdw_switch              = 0.9
rvdw                     = 1.6
DispCorr                 = No
table-extension          = 1
energygrp_table          = 
fourierspacing           = 0.12
fourier_nx               = 0
fourier_ny               = 0
fourier_nz               = 0
pme_order                = 4
ewald_rtol               = 1e-05
ewald_geometry           = 3d
epsilon_surface          = 0
optimize_fft             = no

; IMPLICIT SOLVENT ALGORITHM
implicit_solvent         = No

; GENERALIZED BORN ELECTROSTATICS
gb_algorithm             = Still
nstgbradii               = 1
rgbradii                 = 1
gb_epsilon_solvent       = 80
gb_saltconc              = 0
gb_obc_alpha             = 1
gb_obc_beta              = 0.8
gb_obc_gamma             = 4.85
gb_dielectric_offset     = 0.009
sa_algorithm             = Ace-approximation
sa_surface_tension       = -1

constraints              = none
constraint_algorithm     = Lincs
continuation             = no
Shake-SOR                = no
shake-tol                = 0.0001
lincs_order              = 4
lincs-iter               = 1
lincs_warnangle          = 90
morse                    = no
