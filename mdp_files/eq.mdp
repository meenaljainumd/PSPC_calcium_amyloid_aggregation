; VARIOUS PREPROCESSING OPTIONS
define                   = -DPOPC_PO4 -DPOPS_PO4 -DPHE_BB

; RUN CONTROL PARAMETERS
integrator               = md
tinit                    = 0.0
dt                       = 0.010
nsteps                   = 5000000 ; 50 ns
init_step                = 0
simulation_part          = 1
comm-mode                = Linear
nstcomm                  = 10
comm-grps                = 

; LANGEVIN DYNAMICS OPTIONS
; Friction coefficient (amu/ps) and random seed
bd-fric                  = 0
ld-seed                  = 1993

; OUTPUT CONTROL OPTIONS
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 1000 ; 1ps
nstenergy                = 1000 ; 1ps
nstxtcout                = 10000 
xtc_precision            = 200

; NEIGHBORSEARCHING PARAMETERS
nstlist                  = 10
ns_type                  = grid
pbc                      = xyz
periodic_molecules       = no
rlist                    = 1.6
rlistlong                = -1

; OPTIONS FOR ELECTROSTATICS AND VDW
coulombtype              = PME
rcoulomb_switch          = 0.0
rcoulomb                 = 1.6
epsilon_r                = 2.5
epsilon_rf               = 1
vdw_type                 = Shift
rvdw_switch              = 0.9
rvdw                     = 1.2
DispCorr                 = No
table-extension          = 1
fourierspacing           = 0.12
fourier_nx               = 0
fourier_ny               = 0
fourier_nz               = 0
pme_order                = 4
ewald_rtol               = 1e-05
ewald_geometry           = 3d
epsilon_surface          = 0
optimize_fft             = no

; Temperature coupling  
tcoupl                   = nose-hoover
nsttcouple               = 1
nh-chain-length          = 10
tc-grps                  = BL PW  Ion	Protein 
tau_t                    = 1	1	1	1
ref_t                    = 300	300	300	300
Pcoupl                   = Berendsen ; Parrinello-Rahman
Pcoupltype               = Surface-Tension
nstpcouple               = 1
tau_p                    = 1      
compressibility          = 3e-5  3e-5
ref_p                    = 743.0   1.0
refcoord_scaling         = no
andersen_seed            = 13221


; GENERATE VELOCITIES FOR STARTUP RUN
gen_vel                  = yes
gen_temp                 = 300
gen_seed                 = 2208

; OPTIONS FOR BONDS    
constraints              = none
constraint_algorithm     = Lincs
continuation             = no
